rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidPhoto(data, userId) {
      return data.userId == userId &&
        data.userId == request.auth.uid &&
        data.seq is number &&
        data.title is string && data.title.size() <= 256 &&
        data.imageUrl is string && data.imageUrl.size() <= 950000;
    }

    // User profile document
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow create, update: if isOwner(userId) && isValidId(userId) && request.resource.data.userId == userId;
      allow delete: if false;

      // User's private photos collection
      match /photos/{photoId} {
        allow get: if isOwner(userId) && isValidId(photoId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(photoId) && isValidPhoto(request.resource.data, userId);
        allow update: if isOwner(userId) && isValidId(photoId) && isValidPhoto(request.resource.data, userId);
        allow delete: if isOwner(userId) && isValidId(photoId);
      }
    }
  }
}
